# 复制本文件为 .env 并填入真实值(.env 已在 .gitignore 中, 切勿提交)
# 说明: 系统环境变量优先级高于 .env 文件

# Token 配置
SECRET_KEY=But you, Lord , are a shield around me, my glory, the One who lifts my head high.

# PostgreSQL 数据库配置
# - Host: localhost 
# - Port: 5432 
# - User: postgres 
# - Password: postgres123 
# - Database: zerd
SQLALCHEMY_DATABASE_URI=postgresql+pg8000://postgres:postgres123@localhost:5432/zerd

# 微信·小程序
APP_ID=
APP_SECRET=

# 微信·开放平台(OPEN)登录
OPEN_APP_ID=
OPEN_APP_SECRET=
OPEN_STATE=

# 微信·公众平台(Account)·服务号登录
ACCOUNT_APP_ID=
ACCOUNT_APP_SECRET=